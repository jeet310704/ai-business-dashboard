# Supabase (public — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key (server-side only — NEVER expose to the browser)
# Find it at: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini (server-side only — never expose to the browser)
GEMINI_API_KEY=your_gemini_api_key
